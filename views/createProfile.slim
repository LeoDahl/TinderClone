h1 Create Profile
- @id = 1
form action="/profile/#{@id}/create" method="post" enctype="multipart/form-data"
  p Name
  input type="text" placeholder="John Doe" name="name"

  p Age
  input type="number" placeholder="18+" name="age"

  p Gender
  select name="gender"
    option value="" Välj kön
    option value="male" Male
    option value="female" Female

  p Profile Picture
  input type="file" name="pfp" accept="image/*"

  br
  input type="submit" value="Skapa"
